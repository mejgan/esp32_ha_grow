CONFIG_GROWBOX_F2_SOIL_RES_PWR_GPIO     CONFIG_GROWBOX_F2_SOIL_PWR_GPIO
CONFIG_GROWBOX_F3_I2C_SDA_GPIO          CONFIG_GROWBOX_I2C_SDA_GPIO
CONFIG_GROWBOX_F3_I2C_SCL_GPIO          CONFIG_GROWBOX_I2C_SCL_GPIO
CONFIG_GROWBOX_F3_LIGHT_SENSOR_GPIO     CONFIG_GROWBOX_F3_LIGHT_GPIO
CONFIG_GROWBOX_SOIL_CAP_DRY_MV          CONFIG_GROWBOX_F1_SOIL_DRY_MV
CONFIG_GROWBOX_SOIL_CAP_WET_MV          CONFIG_GROWBOX_F1_SOIL_WET_MV
CONFIG_GROWBOX_SOIL_RES_DRY_MV          CONFIG_GROWBOX_F2_SOIL_DRY_MV
