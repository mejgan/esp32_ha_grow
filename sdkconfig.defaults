CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y

# 1 ms tick: sensor waits of a few milliseconds are exact (the 100 Hz default rounds 5 ms down to 0).
CONFIG_FREERTOS_HZ=1000

# Zigbee OTA: a new image that never confirms itself is rolled back on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
